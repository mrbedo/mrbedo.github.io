---
---
{% assign images = site.static_files | where_exp: "f", "f.path contains '/src/'" | where_exp: "f", "f.extname == '.jpg' or f.extname == '.JPG' or f.extname == '.jpeg' or f.extname == '.JPEG' or f.extname == '.png' or f.extname == '.PNG'" %}
[
{% for image in images %}
  {"name": {{ image.basename | jsonify }}, "image": {{ image.path | relative_url | jsonify }}}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
